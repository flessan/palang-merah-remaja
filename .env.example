# Telegraph Cloud — data & object storage untuk proyek ini.
# Salin berkas ini menjadi .env lalu isi nilainya. JANGAN pernah commit nilai asli.
#
# Kunci dibuat di https://telestorage.pages.dev/console (Project > API > API Keys)
# dengan scope db:read, db:write, storage:read, storage:write — hanya ditampilkan sekali.

TELEGRAPH_URL=https://telestorage.pages.dev
TELEGRAPH_PROJECT=prj_Ooc9HEir37tMqV3Q5uWUMw
TELEGRAPH_API_KEY=

# Object storage lewat endpoint S3-compatible (SigV4, region us-east-1, path-style).
S3_ENDPOINT=https://telestorage.pages.dev/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
