# PMR Wira — Cloudflare Pages Functions environment.
#
# Copy this file to `.dev.vars` for local `wrangler pages dev` work. In
# production set the same names under Pages → Settings → Environment variables.
#
# These values are only ever read server-side by `functions/**`. They are never
# prefixed with VITE_ and never bundled into the browser JavaScript.

# Base URL of the Telegraph Cloud deployment that stores PMR content.
TELEGRAPH_URL=https://telegraph-cloud.example.workers.dev

# Telegraph Cloud developer Bearer key (tg_live_…) with db:read, db:write,
# storage:read, and storage:write scopes. Server-side only.
TELEGRAPH_API_KEY=tg_live_replace_me

# Opaque Telegraph Cloud project id (prj_…) that owns the PMR collections.
TELEGRAPH_PROJECT_ID=prj_replace_me

# Telegraph Cloud storage bucket that holds PMR media (public delivery path
# /p/<projectId>/<bucket>/<key>).
TELEGRAPH_BUCKET=pmr-assets

# PIN for the PMR admin portal. Any non-empty value; keep it private.
ADMIN_PIN=2026

# Optional cache TTL (seconds) for the public /api/content read-through cache.
PMR_CONTENT_CACHE_TTL=60
